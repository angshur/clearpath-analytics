---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout
  title="Clearpath — Marketing Intelligence & AI Infrastructure"
  description="Measurement modernization, data infrastructure, and AI agent architecture for marketing and data leaders."
  keywords={['marketing measurement', 'MMM', 'AI agent architecture', 'data infrastructure', 'incrementality', 'clean rooms']}
>

<!-- HERO -->
<section class="hero">
  <span class="hero-eyebrow">Marketing intelligence &amp; AI infrastructure</span>
  <h1>Your CFO doesn't trust<br>your marketing numbers.<br><em>Neither should you</em> —<br>until you fix the stack.</h1>
  <p class="hero-sub">
    I help marketing and data leaders build the measurement infrastructure, data foundations, and AI agent architecture to know what's actually working — and act on it faster than competitors who are still pulling reports manually.
  </p>
  <div class="hero-actions">
    <a href="#contact" class="btn-filled">Start the conversation →</a>
    <a href="#practices" class="btn-outlined">See the work</a>
  </div>
</section>

<!-- PROBLEM STRIP -->
<section class="problem-strip">
  <div class="problem-strip-inner">
    <span class="caveat-label" style="color:var(--amber-mid);">Sound familiar?</span>
    <div class="problem-grid">
      <div class="problem-item">
        <div class="problem-number">01</div>
        <div class="problem-title">The CFO meeting nobody wins</div>
        <div class="problem-body">Google says ROAS 4.2. Meta says 3.8. Your CRM disagrees with both. You can't confidently defend the budget because the numbers don't agree.</div>
      </div>
      <div class="problem-item">
        <div class="problem-number">02</div>
        <div class="problem-title">Your best analyst pulls reports</div>
        <div class="problem-body">Tuesday through Thursday, your strongest data person reconciles eight platforms instead of doing analysis. The deck is outdated before Friday's presentation.</div>
      </div>
      <div class="problem-item">
        <div class="problem-number">03</div>
        <div class="problem-title">Planning on last quarter's data</div>
        <div class="problem-body">Next quarter's budget decisions get made on incomplete, lagged information. You're not confident enough to stake a $500K reallocation on what you actually have.</div>
      </div>
    </div>
  </div>
</section>

<!-- PRACTICES -->
<section class="practices-section" id="practices">
  <span class="caveat-label">Three ways we work together</span>
  <h2 class="section-h2">The practice areas — each a distinct engagement.</h2>

  <div class="practice-card">
    <div class="practice-card-inner">
      <div>
        <div class="practice-num">Practice 01</div>
        <span class="practice-badge badge-amber">Highest urgency</span>
        <h3 class="practice-title">Measurement Modernization</h3>
        <p class="practice-desc">
          Attribution is broken. Cookies are gone. Platform numbers disagree with each other and with your CRM. This practice rebuilds your measurement stack from the ground up — MMM for strategic budget allocation, incrementality testing for causal proof, and MTA for the channels where it still works — into a single framework your CMO can defend in the boardroom.
        </p>
        <div class="service-tags">
          <span class="service-tag">Measurement Audit</span>
          <span class="service-tag">MMM Setup + 90-day roadmap</span>
          <span class="service-tag">Incrementality testing</span>
          <span class="service-tag">MTA modernization</span>
          <span class="service-tag">Signal loss recovery</span>
        </div>
        <p class="practice-buyer"><strong>Primary buyer:</strong> CMO, VP Marketing, Head of Growth &nbsp;·&nbsp; <strong>Also:</strong> Head of Analytics, Marketing Ops</p>
        <a href="/services/measurement" class="practice-link">See this practice →</a>
      </div>
      <div class="practice-price">
        <span class="price-from">Starting from</span>
        <div class="price-num">$5K</div>
        <div class="price-to">to $35K</div>
      </div>
    </div>
  </div>

  <div class="practice-card">
    <div class="practice-card-inner">
      <div>
        <div class="practice-num">Practice 02</div>
        <span class="practice-badge badge-teal">Deep technical moat</span>
        <h3 class="practice-title">Data Infrastructure &amp; Semantic Layer</h3>
        <p class="practice-desc">
          Measurement only works if the data underneath it is trustworthy. This practice builds the normalized, governed data foundation — pipelines, warehouse architecture, semantic layer — that makes your analytics reliable and your AI agents useful rather than hallucinating. Particularly relevant for organizations with fragmented data across platforms, cloud migrations underway, or a gap between raw data and actionable insight.
        </p>
        <div class="service-tags">
          <span class="service-tag">Data architecture design</span>
          <span class="service-tag">Semantic layer build</span>
          <span class="service-tag">Connector normalization</span>
          <span class="service-tag">Snowflake / BigQuery</span>
          <span class="service-tag">dbt modeling</span>
          <span class="service-tag">Pipeline audit</span>
        </div>
        <p class="practice-buyer"><strong>Primary buyer:</strong> CDO, Head of Data, VP Analytics &nbsp;·&nbsp; <strong>Also:</strong> CTOs at marketing-heavy orgs, agency data leads</p>
        <a href="/services/data-engineering" class="practice-link">See this practice →</a>
      </div>
      <div class="practice-price">
        <span class="price-from">Starting from</span>
        <div class="price-num">$15K</div>
        <div class="price-to">to $25K</div>
      </div>
    </div>
  </div>

  <div class="practice-card">
    <div class="practice-card-inner">
      <div>
        <div class="practice-num">Practice 03</div>
        <span class="practice-badge badge-purple">Highest fee potential</span>
        <h3 class="practice-title">AI Agent Architecture</h3>
        <p class="practice-desc">
          When your data is clean and your measurement is credible, the next question is how to automate what comes next. This practice designs the agent stack — which workflows automate, how orchestration works, how governance is enforced so agents act without going rogue. The result: analytics that run continuously without manual intervention, anomaly detection that escalates before damage compounds, and reporting that generates itself.
        </p>
        <div class="service-tags">
          <span class="service-tag">Agent stack design</span>
          <span class="service-tag">Orchestration patterns</span>
          <span class="service-tag">Human-in-the-loop governance</span>
          <span class="service-tag">Agentic reporting</span>
          <span class="service-tag">AI transition roadmap</span>
        </div>
        <p class="practice-buyer"><strong>Primary buyer:</strong> CDO, Head of Marketing Ops, CTO &nbsp;·&nbsp; <strong>Also:</strong> CMOs at AI-forward orgs, data-heavy agencies</p>
        <a href="/services/agent-architecture" class="practice-link">See this practice →</a>
      </div>
      <div class="practice-price">
        <span class="price-from">Starting from</span>
        <div class="price-num">$25K</div>
        <div class="price-to">to $50K</div>
      </div>
    </div>
  </div>

  <div class="retainer-bar">
    <div>
      <div class="retainer-title">Ongoing Advisory Retainer</div>
      <div class="retainer-desc">Continuous access for strategy, architecture reviews, and implementation oversight across any practice area.</div>
    </div>
    <div class="retainer-price">
      <div class="price-from">Monthly</div>
      <div class="price-num" style="font-size:1.05rem;">$5K – $10K</div>
    </div>
  </div>
</section>

<!-- DIFFERENTIATORS -->
<section class="diff-section">
  <div class="diff-inner">
    <span class="caveat-label">Why Clearpath</span>
    <h2 class="section-h2">Not another consultant who read the same reports you did.</h2>
    <div class="diff-grid">
      <div class="diff-item">
        <div class="diff-icon">⬡</div>
        <div class="diff-title">Built at scale, not theorized</div>
        <div class="diff-body">200+ data connectors. $10B+ in ad spend processed annually. Production AI agent systems. The infrastructure problems I help you solve are ones I spent a decade building and breaking first.</div>
      </div>
      <div class="diff-item">
        <div class="diff-icon">⬡</div>
        <div class="diff-title">Domain-specific, not generic</div>
        <div class="diff-body">The measurement and data infrastructure challenges in marketing are structurally different from other domains — walled gardens, attribution windows, signal loss, multi-platform normalization. I work in this specific domain, not around it.</div>
      </div>
      <div class="diff-item">
        <div class="diff-icon">⬡</div>
        <div class="diff-title">Fixed scope, real deliverables</div>
        <div class="diff-body">Every engagement has a defined output — an architecture, a model, a roadmap, a working system. No open-ended retainers before you've seen what I deliver. Clear scope, clear value, clear end date.</div>
      </div>
      <div class="diff-item">
        <div class="diff-icon">⬡</div>
        <div class="diff-title">Practitioner, not just advisor</div>
        <div class="diff-body">I'm actively building the systems I advise on. SaaSMatchup, measurement tools, agentic workflows. The best consulting comes from someone still in the arena — not describing a past life.</div>
      </div>
    </div>
  </div>
</section>

<!-- ENGAGEMENT MODEL -->
<section class="engagement-section">
  <span class="caveat-label">How it works</span>
  <h2 class="section-h2">From first conversation to working system.</h2>
  <div class="engagement-grid">
    <div class="eng-step">
      <div class="eng-num">01</div>
      <div class="eng-title">Initial conversation</div>
      <div class="eng-body">30 minutes. You describe what you're trying to solve. I tell you whether I'm the right person and which practice fits — no pitch.</div>
    </div>
    <div class="eng-step">
      <div class="eng-num">02</div>
      <div class="eng-title">Scoped proposal</div>
      <div class="eng-body">Fixed deliverables, fixed price, defined timeline. No ambiguity about what you're buying or what I'm delivering.</div>
    </div>
    <div class="eng-step">
      <div class="eng-num">03</div>
      <div class="eng-title">Engagement</div>
      <div class="eng-body">Working sessions, architecture reviews, and direct Slack access. I'm in it with you — not handing off to a junior team.</div>
    </div>
    <div class="eng-step" style="border-right:none;">
      <div class="eng-num">04</div>
      <div class="eng-title">Deliverable + handoff</div>
      <div class="eng-body">A working system, a documented architecture, or a roadmap your team can execute. Then a retainer if you want to keep going.</div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section class="about-section" id="about">
  <div class="about-inner">
    <div class="about-left">
      <span class="caveat-label">About</span>
      <h2>Angshuman Rudra</h2>
      <p>For ten years I was the founding product leader at TapClicks — building the data and AI infrastructure that thousands of marketing agencies run on. 200+ data connectors. Production AI agent systems. ETL pipelines at $10B+ in annual ad spend processed annually.</p>
      <p>Before that: Yahoo, Adobe, Xilinx. I've built the full stack — from raw ingestion through agentic workflows — across two decades. I'm not describing a future I'm predicting. I'm describing a present I've spent years building.</p>
      <div class="creds">
        <span class="cred">Ex-TapClicks — Founding PM</span>
        <span class="cred">Yahoo · Adobe</span>
        <span class="cred">Forbes Technology Council</span>
        <span class="cred">Cornell MBA</span>
        <span class="cred">MS Computer Science</span>
      </div>
    </div>
    <div class="about-right">
      <div class="stat-row"><span class="stat-label">Data connectors built</span><span class="stat-value">200+</span></div>
      <div class="stat-row"><span class="stat-label">Annual ad spend processed</span><span class="stat-value">$10B+</span></div>
      <div class="stat-row"><span class="stat-label">Years in data + AI infrastructure</span><span class="stat-value">20+</span></div>
      <div class="stat-row"><span class="stat-label">Engagement model</span><span class="stat-value">Fixed scope only</span></div>
      <div class="stat-row"><span class="stat-label">Currently also building</span><span class="stat-value">SaaSMatchup · Porino</span></div>
    </div>
  </div>
</section>

<!-- WRITING -->
<section class="writing-section">
  <div class="writing-inner">
    <div class="writing-header">
      <div>
        <span class="caveat-label">From the blog</span>
        <h2 class="section-h2" style="margin-bottom:0;">Thinking out loud about measurement, data, and AI.</h2>
      </div>
      <a href="/blog" class="btn-outlined">View all →</a>
    </div>
    <div class="posts-grid">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="post-card">
          <div class="post-tags">
            {(post.data.keywords ?? []).slice(0, 2).map((k: string) => (
              <span class="post-tag">{k}</span>
            ))}
          </div>
          <h3 class="post-title">{post.data.title}</h3>
          <p class="post-desc">{post.data.description}</p>
          <div class="post-footer">
            <span class="post-date">{post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span>
            <span class="post-read">Read →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="contact-section" id="contact">
  <span class="caveat-label">Get in touch</span>
  <h2 class="section-h2" style="text-align:center;max-width:480px;margin:0 auto 0.75rem;">Let's figure out if this is the right fit.</h2>
  <p class="contact-sub">No pitch, no sales process. Tell me what you're working on. I'll reply within one business day with an honest assessment of whether I can help.</p>
  <div class="contact-form-wrap">
    <div class="form-row">
      <label class="form-label">Name</label>
      <input id="cf-name" type="text" class="form-input" placeholder="Your name" />
    </div>
    <div class="form-row">
      <label class="form-label">Email</label>
      <input id="cf-email" type="email" class="form-input" placeholder="you@company.com" />
    </div>
    <div class="form-row">
      <label class="form-label">Which practice is most relevant?</label>
      <select id="cf-practice" class="form-input" style="cursor:pointer;">
        <option value="">Select one</option>
        <option>Practice 1 — Measurement Modernization</option>
        <option>Practice 2 — Data Infrastructure &amp; Semantic Layer</option>
        <option>Practice 3 — AI Agent Architecture</option>
        <option>Not sure yet — need to talk it through</option>
      </select>
    </div>
    <div class="form-row">
      <label class="form-label">What are you working on?</label>
      <textarea id="cf-message" class="form-input form-textarea" placeholder="Brief description of the problem or project..."></textarea>
    </div>
    <button id="cf-submit" class="form-submit">Send →</button>
    <div id="cf-success" class="form-success" style="display:none;">✓ Message sent! I'll be in touch within 1 business day.</div>
    <div id="cf-error" class="form-error" style="display:none;">Something went wrong. Please email me directly at angshuman.rudra@gmail.com</div>
  </div>
  <p class="contact-alt">Or email directly: <a href="mailto:angshuman.rudra@gmail.com">angshuman.rudra@gmail.com</a></p>
</section>

</Layout>

<style>
/* ── PAGE-LEVEL OVERRIDES ── */
:root {
  --bg2: #F3EFE8;
  --bg3: #EDE8DF;
  --ink2: #3D3830;
  --ink3: #6B6459;
  --amber-mid: #F59E0B;
  --border-c: #DDD8CF;
  --border-dark: #C8C2B5;
  --shadow-c: 4px 4px 0px #C8C2B5;
  --shadow-amber: 4px 4px 0px #D97706;
}

/* ── HERO ── */
.hero {
  padding: 96px 2rem 80px;
  max-width: 900px;
  margin: 0 auto;
}
.hero-eyebrow {
  font-family: 'Caveat', cursive;
  font-size: 1.1rem;
  color: var(--amber);
  margin-bottom: 1.25rem;
  display: block;
  animation: fadeUp 0.5s ease both;
}
.hero h1 {
  font-family: 'Lora', serif;
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  font-weight: 600;
  line-height: 1.18;
  letter-spacing: -0.02em;
  color: var(--ink);
  margin-bottom: 1.5rem;
  animation: fadeUp 0.5s 0.1s ease both;
}
.hero h1 em { font-style: italic; color: var(--amber); }
.hero-sub {
  font-size: 1.1rem;
  color: var(--ink2);
  max-width: 580px;
  line-height: 1.7;
  margin-bottom: 2.5rem;
  font-weight: 300;
  animation: fadeUp 0.5s 0.2s ease both;
}
.hero-actions {
  display: flex;
  gap: 1rem;
  align-items: center;
  flex-wrap: wrap;
  animation: fadeUp 0.5s 0.3s ease both;
}
.btn-filled {
  display: inline-block;
  font-size: 0.9rem;
  font-weight: 500;
  color: #FAF7F2;
  background: var(--ink);
  padding: 12px 28px;
  border: 1.5px solid var(--ink);
  box-shadow: var(--shadow-c);
  text-decoration: none;
  transition: all 0.15s;
  letter-spacing: 0.01em;
}
.btn-filled:hover { box-shadow: none; transform: translate(4px, 4px); }
.btn-outlined {
  display: inline-block;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--ink);
  padding: 12px 28px;
  border: 1.5px solid var(--border-dark);
  text-decoration: none;
  transition: border-color 0.15s;
  background: transparent;
}
.btn-outlined:hover { border-color: var(--ink); }

/* ── PROBLEM STRIP ── */
.problem-strip {
  background: var(--ink);
  color: #FAF7F2;
  padding: 3rem 2rem;
}
.problem-strip-inner { max-width: 900px; margin: 0 auto; }
.problem-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-top: 1.25rem;
}
.problem-item {
  padding: 1.5rem 1.75rem 1.5rem 0;
  border-right: 1px solid rgba(255,255,255,0.1);
}
.problem-item:last-child { border-right: none; padding-right: 0; padding-left: 1.75rem; }
.problem-item:nth-child(2) { padding-left: 1.75rem; }
.problem-number {
  font-family: 'Lora', serif;
  font-size: 2rem;
  font-weight: 600;
  color: var(--amber-mid);
  opacity: 0.4;
  line-height: 1;
  margin-bottom: 0.5rem;
}
.problem-title {
  font-family: 'Lora', serif;
  font-size: 1rem;
  font-weight: 500;
  color: #F5F0E8;
  margin-bottom: 0.5rem;
  line-height: 1.3;
}
.problem-body { font-size: 0.82rem; color: rgba(245,240,232,0.6); line-height: 1.6; font-weight: 300; }

/* ── PRACTICES ── */
.practices-section {
  padding: 6rem 2rem;
  max-width: 900px;
  margin: 0 auto;
}
.caveat-label {
  font-family: 'Caveat', cursive;
  font-size: 1rem;
  color: var(--amber);
  margin-bottom: 1rem;
  display: block;
}
.section-h2 {
  font-family: 'Lora', serif;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ink);
  margin-bottom: 3.5rem;
  max-width: 520px;
  line-height: 1.25;
}
.practice-card {
  border: 1.5px solid var(--border-c);
  background: #FAF7F2;
  margin-bottom: 1.5rem;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.practice-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: var(--border-dark);
  transition: background 0.2s;
}
.practice-card:hover { box-shadow: var(--shadow-c); transform: translate(-2px, -2px); }
.practice-card:hover::before { background: var(--amber); }
.practice-card-inner {
  padding: 2rem 2rem 2rem 2.25rem;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 1.5rem;
  align-items: start;
}
.practice-num { font-family: 'Lora', serif; font-size: 0.75rem; color: var(--ink3); font-style: italic; margin-bottom: 0.25rem; }
.practice-badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 3px 8px;
  margin-bottom: 0.75rem;
}
.badge-amber { color: var(--amber); background: #FEF3C7; }
.badge-teal { color: #085041; background: #EDF6F3; }
.badge-purple { color: #3C3489; background: #F0EDF8; }
.practice-title {
  font-family: 'Lora', serif;
  font-size: 1.35rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ink);
  margin-bottom: 0.75rem;
  line-height: 1.25;
}
.practice-desc {
  font-size: 0.9rem;
  color: var(--ink2);
  line-height: 1.7;
  font-weight: 300;
  margin-bottom: 1.25rem;
  max-width: 520px;
}
.service-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1.25rem; }
.service-tag { font-size: 0.75rem; color: var(--ink3); border: 1px solid var(--border-c); padding: 3px 10px; background: var(--bg2); }
.practice-buyer { font-size: 0.78rem; color: var(--ink3); font-style: italic; }
.practice-buyer strong { color: var(--ink2); font-style: normal; font-weight: 500; }
.practice-price { text-align: right; flex-shrink: 0; }
.price-from { font-size: 0.7rem; color: var(--ink3); text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 2px; }
.price-num { font-family: 'Lora', serif; font-size: 1.1rem; font-weight: 600; color: var(--ink); }
.price-to { font-size: 0.7rem; color: var(--ink3); margin-top: 4px; }
.practice-link {
  font-size: 0.82rem; font-weight: 500; color: var(--amber); text-decoration: none;
  display: inline-flex; align-items: center; gap: 4px; margin-top: 0.75rem;
  transition: gap 0.15s;
}
.practice-link:hover { gap: 8px; }
.retainer-bar {
  border: 1px solid var(--border-c);
  padding: 1.25rem 1.5rem;
  background: var(--bg2);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 0.5rem;
}
.retainer-title { font-family: 'Lora', serif; font-size: 0.95rem; font-weight: 600; color: var(--ink); margin-bottom: 0.2rem; }
.retainer-desc { font-size: 0.8rem; color: var(--ink3); font-weight: 300; }
.retainer-price { text-align: right; flex-shrink: 0; }

/* ── DIFFERENTIATORS ── */
.diff-section {
  background: var(--bg2);
  border-top: 1px solid var(--border-c);
  border-bottom: 1px solid var(--border-c);
  padding: 5rem 2rem;
}
.diff-inner { max-width: 900px; margin: 0 auto; }
.diff-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 3rem; }
.diff-item {
  padding: 1.75rem;
  background: #FAF7F2;
  border: 1px solid var(--border-c);
  box-shadow: var(--shadow-c);
}
.diff-icon { font-size: 1.1rem; margin-bottom: 0.75rem; }
.diff-title { font-family: 'Lora', serif; font-size: 1.05rem; font-weight: 600; color: var(--ink); margin-bottom: 0.5rem; letter-spacing: -0.01em; }
.diff-body { font-size: 0.85rem; color: var(--ink3); line-height: 1.65; font-weight: 300; }

/* ── ENGAGEMENT ── */
.engagement-section { padding: 6rem 2rem; max-width: 900px; margin: 0 auto; }
.engagement-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1.5px solid var(--border-c);
