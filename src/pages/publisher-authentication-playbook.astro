    display: none;
    margin-top: 12px;
    padding: 12px 16px;
    background: rgba(77,124,95,0.2);
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--cream);
  }

  /* calculator link */
  .calc-link-box {
    background: var(--amber-xlight);
    border: 1.5px solid rgba(217,119,6,0.25);
    border-radius: var(--radius);
    padding: 20px 24px;
    margin: 32px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .calc-link-box p {
    font-size: 14px;
    color: var(--ink-mid);
    margin: 0;
  }
  .calc-link-box a {
    flex-shrink: 0;
    padding: 10px 20px;
    background: var(--amber);
    color: white;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 600;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .calc-link-box a:hover { opacity: 0.88; }

  .prose h2 {
    font-size: clamp(20px, 3vw, 26px);
    margin-top: 48px;
    margin-bottom: 16px;
  }
  .prose h3 { font-size: 19px; margin-top: 32px; margin-bottom: 12px; }
  .prose p { font-size: 16px; line-height: 1.8; color: var(--ink-mid); margin-bottom: 18px; }
