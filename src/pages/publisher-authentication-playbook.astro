    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--cream);
    margin-bottom: 10px;
  }
  .cta-box p {
    font-size: 15px;
    color: rgba(250,247,242,0.68);
    line-height: 1.7;
    margin-bottom: 20px;
  }
  .email-row { display: flex; gap: 10px; }
  .email-input {
    flex: 1;
    padding: 10px 16px;
    border: 1.5px solid rgba(250,247,242,0.25);
    border-radius: var(--radius-sm);
    font-size: 15px;
    font-family: var(--font-body);
    background: rgba(255,255,255,0.07);
    color: var(--cream);
