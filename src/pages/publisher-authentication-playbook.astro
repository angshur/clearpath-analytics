  .mid-perf { color: var(--amber); font-weight: 600; }
  .low { color: var(--rust); font-weight: 600; }

  /* CTA box */
  .cta-box {
    background: var(--ink);
    border-radius: var(--radius);
    padding: 36px;
    margin: 48px 0 0;
    box-shadow: 4px 4px 0 var(--amber);
