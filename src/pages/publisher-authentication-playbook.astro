---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="The Authentication Rate Playbook — How Publishers Turn Login Into Revenue"
  description="The CPM math behind authentication rate, five mechanisms to increase it, and a decision framework for registration walls vs. hard paywalls. For VP Revenue, digital publishers, and publisher CEOs."
  keywords={['publisher authentication rate', 'authenticated traffic', 'publisher revenue', 'registration wall', 'paywall strategy', 'RampID publisher', 'publisher first-party data']}
>

<style>
  /* ── HERO ─── */
  .hero {
    background: var(--paper);
    border-bottom: 1.5px solid var(--border);
    padding: 72px 48px 64px;
  }
  .hero-inner { max-width: 720px; margin: 0 auto; }
  .hero-meta {
    font-size: 13px;
    color: var(--ink-dim);
    margin-bottom: 16px;
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .hero-meta span { display: flex; align-items: center; gap: 5px; }
  .hero h1 {
    font-size: clamp(30px, 4.5vw, 52px);
    line-height: 1.08;
    margin-bottom: 20px;
  }
  .hero .dek {
    font-size: 19px;
    color: var(--ink-mid);
    line-height: 1.7;
    max-width: 620px;
    margin-bottom: 28px;
  }
  .hero-cta-row {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-cta-label {
    font-size: 13px;
    color: var(--ink-dim);
  }

  /* ── CONTENT ─── */
  .content-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 48px 96px;
  }

  /* pull quote / stat boxes */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 40px 0;
  }
  .stat-card {
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 20px;
    text-align: center;
  }
  .stat-number {
    font-family: var(--font-serif);
    font-size: 36px;
    font-weight: 700;
    color: var(--amber);
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-label {
    font-size: 13px;
    color: var(--ink-mid);
    line-height: 1.5;
  }

  /* section headings */
  .section-divider {
    border: none;
    border-top: 1.5px solid var(--border);
    margin: 48px 0;
  }
  .section-num {
    font-family: var(--font-accent);
    font-size: 17px;
    color: var(--amber);
    font-weight: 600;
    display: block;
    margin-bottom: 6px;
  }

  /* mechanism cards */
  .mechanism-list { display: flex; flex-direction: column; gap: 20px; margin: 28px 0; }
  .mechanism-card {
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 28px 28px 28px 24px;
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 20px;
    align-items: start;
  }
  .mechanism-num {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--amber);
    line-height: 1;
    padding-top: 4px;
  }
  .mechanism-card h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }
  .mechanism-card p {
    font-size: 15px;
    color: var(--ink-mid);
    line-height: 1.7;
    margin-bottom: 10px;
  }
  .mechanism-card p:last-child { margin-bottom: 0; }
  .mechanism-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 3px 8px;
    border-radius: 4px;
    margin-top: 4px;
  }
  .tag-fast { background: var(--sage-light); color: var(--sage); }
  .tag-medium { background: var(--amber-light); color: var(--amber); }
  .tag-strategic { background: var(--blue-light); color: var(--blue); }

  /* CPM math table */
  .cpm-table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
  }
  .cpm-table th {
    background: var(--ink);
    color: var(--cream);
    padding: 12px 16px;
    text-align: left;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
  }
  .cpm-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--ink-mid);
  }
  .cpm-table tr:last-child td { border-bottom: none; }
  .cpm-table tr:nth-child(even) td { background: var(--cream-dark); }
  .cpm-table .highlight-row td {
    background: var(--amber-xlight);
    color: var(--ink);
    font-weight: 600;
  }
  .cpm-table .total-row td {
    background: var(--ink);
    color: var(--cream);
    font-weight: 600;
  }

  /* decision framework */
  .decision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 28px 0;
  }
  .decision-card {
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .decision-card h3 {
    font-size: 17px;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .decision-card ul {
    list-style: none;
    padding: 0;
  }
  .decision-card li {
    font-size: 14px;
    color: var(--ink-mid);
    line-height: 1.6;
    padding: 5px 0;
    padding-left: 18px;
    position: relative;
  }
  .decision-card li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--amber);
    font-size: 12px;
  }
  .decision-card.recommended { border-color: var(--amber); }
  .decision-card.recommended h3 { color: var(--amber); }

  /* pull quote */
  .pull-quote {
    border-left: 3px solid var(--amber);
    padding: 4px 0 4px 24px;
    margin: 32px 0;
  }
  .pull-quote p {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.45;
    margin: 0;
  }

  /* inline note */
  .inline-note {
    background: var(--cream-dark);
    border-radius: var(--radius-sm);
    padding: 14px 18px;
    font-size: 13px;
    color: var(--ink-mid);
    line-height: 1.65;
    margin: 20px 0;
  }
  .inline-note strong { color: var(--ink); }

  /* benchmark table */
  .benchmark-table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 14px;
  }
  .benchmark-table th {
